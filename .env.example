DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
TAHLA_COOKIE_SECRET="your-secret-at-least-32-chars"
NODE_ENV=

# Email (Resend — https://resend.com)
RESEND_API_KEY=""
# Optional: verified domain sender, e.g. "Təhlə Tətbiqi <mail@yourdomain.com>" (defaults to onboarding@resend.dev)
RESEND_FROM=""
# Canonical public URL (emails, redirects). Prefer APP_URL on Railway; NEXT_PUBLIC_APP_URL is a fallback.
APP_URL=
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Images (Cloudinary — https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
